# 大模型 API Key（必填）。DeepSeek 控制台：https://platform.deepseek.com/
# 只填等号右边，不要加引号，不要留空格。
DEEPSEEK_API_KEY=

# 下面几项一般不用改，需要覆盖时取消注释
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-flash

# NapCat 的 WebSocket 地址，默认本机 3001 端口
# ONEBOT_WS=ws://127.0.0.1:3001

# OneBot 的 token：一般直接写在 config.json 的 onebot.token 里，不用在这填。
# 填了会覆盖 config.json 的值；留空（ONEBOT_TOKEN=）等于不覆盖，不会把校验关掉。
# ONEBOT_TOKEN=
